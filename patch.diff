-    void Shuffle<T>(IList<T> list)
+    void Shuffle<T>(IList<T> list)
     {
         if (_rng == null) _rng = new System.Random(Environment.TickCount);
         for (int i = list.Count - 1; i > 0; i--)
         {
             int j = _rng.Next(i + 1);
             (list[i], list[j]) = (list[j], list[i]);
         }
     }
