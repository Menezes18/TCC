  m_Name: "Editor de Cria\xE7\xE3o de Level"
  m_EditorClassIdentifier: Assembly-CSharp::ProjectFeatures.FeatureEntry
  titulo: "Editor de Cria\xE7\xE3o de Level"
  categoria: 1
  tipo: "Editor para Cria\xE7\xE3o de Levels"
  descricaoCurta: "Editor para cria\xE7\xE3o procedural de level's que incluam multiplos
    objetos com ou sem espa\xE7amento. Um exemplo, \xE9 o Minigame de Queda de Plataformas."
  descricaoLonga: "Dentro da \xE1rea de desenvolvimento de jogos \xE9 necess\xE1rio
    a cria\xE7\xE3o de Levels. Muitos deles, s\xE3o necess\xE1rias tarefas repetitivas
    para cria\xE7\xE3o de muitas intera\xE7\xF5es em um \nespa\xE7o. Para solucionar
    isso, foi criado uma ferramenta que permite o posicionamento e a gera\xE7\xE3o
    procedural de Mesh's em determinadas posi\xE7\xF5es no espa\xE7o. Por ela \xE9\nposs\xEDvel
    a visualiza\xE7\xE3o em formato de pre-renderiza\xE7\xE3o e a efetiva\xE7\xE3o
    para testes em formato prefab."
  responsavel: "Grupo de Programa\xE7\xE3o"
  tags:
  - Editor
  - "Otimiza\xE7\xE3o"
  - Level Design
  status: 2
