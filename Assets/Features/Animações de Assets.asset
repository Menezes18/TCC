  m_Script: {fileID: 11500000, guid: 81fd9d097680c77409c827ad60ec1543, type: 3}
  m_Name: "Anima\xE7\xF5es de Assets"
  m_EditorClassIdentifier: Assembly-CSharp::ProjectFeatures.FeatureEntry
  titulo: "Anima\xE7\xF5es de Assets"
  categoria: 2
  tipo: "Anima\xE7\xE3o"
  descricaoCurta: "Anima\xE7\xE3o de objetos e obst\xE1culos importantes dentro de
    jogo - incluindo lobby e minigames."
  descricaoLonga: "O jogo passou por 3 polimentos de lobby e diversos polimentos
    para cada minigame. Com objetivo de chegar em um bom resultado, foi desenvolvido
    anima\xE7\xF5es importantes para melhorar o feeling dentro das mudan\xE7as finais
    do jogo. Dentre elas, est\xE3o os assets mais importantes do lobby ( interativos
    ) e os obst\xE1culos not\xE1veis do jogo.\nComo destaque principal est\xE3o os
    s\xEDmios que aparecem como forma de atrapalhar o jogador principal dentro dos
    minigames e os diversos objetos com anima\xE7\xF5es bruscas para afetar a integridade
    do player ou auxili\xE1-lo de alguma outra forma."
  responsavel: "Grupo de Anima\xE7\xE3o"
  tags:
  - "Anima\xE7\xE3o"
  - Assets
  - Game Juice
  - Polimento
  status: 2
